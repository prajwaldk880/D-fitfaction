# Life Protecter Environment Configuration

# Backend Settings
APP_NAME=Life Protecter
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database URL
# Leave commented or use SQLite for zero-config local development:
DATABASE_URL=sqlite:///./life_protecter.db
# For PostgreSQL + PostGIS:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/life_protecter

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenStreetMap Overpass API
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=15
OVERPASS_CACHE_TTL_MINUTES=30
OVERPASS_USER_AGENT=LifeProtecterHealthcareApp/1.0

# Optional External Geocoding (Nominatim)
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# Frontend API Base URL (used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api
